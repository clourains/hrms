# HRMS 环境变量示例：复制为 .env 后按需修改（.env 已被 .gitignore 忽略）
# 仅本地演示可使用默认值；部署到任何可访问环境前必须全部改成强口令/随机密钥

# ---- 数据库 / Redis（后端 application.yml 与 docker-compose 共用） ----
HRMS_DB_USERNAME=root
HRMS_DB_PASSWORD=change-me
HRMS_REDIS_HOST=localhost
HRMS_REDIS_PORT=6379
HRMS_REDIS_PASSWORD=change-me

# ---- JWT（必须修改：默认值已公开，可被用于伪造管理员 token） ----
JWT_SECRET=change-me-to-a-long-random-string

# ---- 跨域允许来源（多个用逗号分隔） ----
HRMS_CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5175

# ---- 第三方物流查询（未配置时同步接口返回「未配置」提示） ----
SEVENTEEN_TRACK_API_KEY=

# ---- AI 模型（默认关闭，按需开启） ----
AI_API_KEY=
AI_BASE_URL=https://api.deepseek.com/v1
AI_MODEL=deepseek-chat

# ---- ERP 演示工程 ----
# 推送到 HRMS 的开放接口 Key（在 HRMS「物流跟踪 → 批量导入运单 → 开放接口」获取）
HRMS_API_KEY=
HRMS_BASE_URL=http://localhost:8080/api
ERP_IMPORT_DIR=./inbox

# ---- Docker Compose 专用 ----
MYSQL_ROOT_PASSWORD=change-me
REDIS_PASSWORD=change-me
